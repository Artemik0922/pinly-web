# Необязательно: ключ Openverse API поднимает лимиты с 200/день до 10000/день.
# Бесплатная регистрация: https://api.openverse.org/v1/auth/registration/
# Скопируйте этот файл в .env.local
OPENVERSE_API_KEY=

# ── Авторизация и аккаунты ──
# Единственный бэкенд — свой (backend/app.py, SQLite). Он же хранит доски,
# лайки, свои пины, подписки и комментарии. Запуск:
#   pip install -r backend/requirements.txt
#   python -m uvicorn backend.app:app --port 8000
# Фронтенд проксирует /api/auth|boards|likes|pins|uploads|users|comments туда
# (rewrites в next.config.ts). Без бэкенда сайт работает анонимно:
# доски и лайки в localStorage.
#
# URL бэкенда (по умолчанию http://127.0.0.1:8000):
# ACCOUNTS_BACKEND_URL=http://127.0.0.1:8000
# Секрет подписи сессий; иначе один раз генерируется в .data/secret.key:
# PINLY_JWT_SECRET=
# Каталог данных для тестов или другого диска (по умолчанию web/.data):
# PINLY_DATA_DIR=
# production: падать, если секрет не переживает перезапуск:
# PINLY_ENV=production
# читать X-Forwarded-For можно только за своим reverse-proxy:
# PINLY_TRUST_PROXY=1
# выключить счётчики «не спамь» целиком — ТОЛЬКО для тестового контура
# (Playwright создаёт доски десятками с одного адреса). В проде не ставить.
# PINLY_DISABLE_RATE_LIMIT=1

# Ключ routerai.ru — включает векторный «умный» поиск и поиск по фото.
# Модель по умолчанию voyageai/voyage-multimodal-3.5: текст и картинка лежат в
# одном пространстве, поэтому запрос-фото находит и текстовые векторы пинов.
# Цена: ~20 ₽ / 1 млн входных токенов. После добавления ключа:
#   npm run index                — текстовый индекс (поиск по слову)
#   npm run index -- --images    — индекс картинок (поиск по фото, точнее)
#   npm run probe:embeddings     — что принимает провайдер и совместим ли индекс
#   npm start
EMBED_API_KEY=
# Необязательно (значения по умолчанию). У voyage-multimodal-3.5 размерность
# берётся из 2048/1024/512/256 — 768 она не умеет.
# EMBED_MODEL=voyageai/voyage-multimodal-3.5
# EMBED_DIMENSIONS=1024
# EMBED_BASE_URL=https://routerai.ru/api/v1
# Сайт, с которого скрипты index/probe берут пины и картинки (по умолчанию
# http://localhost:3000):
# INDEX_BASE_URL=http://localhost:3000

# ── Адрес сайта ──
# Домен попадает в canonical, OG-ссылки и sitemap.xml. Без него они ведут на
# localhost:3000 — в проде задать обязательно.
# NEXT_PUBLIC_SITE_URL=https://pinly.example
# Сборка с этим флагом и пустым доменом падает вместо того, чтобы молча
# собрать сайт, у которого все адреса ведут на машинку разработчика. В CI
# флаг не ставят: там собирается example.invalid.
# PINLY_REQUIRE_SITE_URL=1

# ── Сводка событий ──
# В проде сводку /api/ev/summary читает только этот аккаунт; без него в проде
# эндпоинт отключён. Локально переменную не задавайте — там доступ по сессии.
# PINLY_OWNER_EMAIL=

# Контакт оператора в политике конфиденциальности (152-ФЗ требует, куда писать
# об отзыве согласия и о данных). Без него в тексте светится служебный адрес.
# PINLY_OPERATOR_EMAIL=

# ── Опциональный внешний хостинг картинок ──
# Позволяет грузить картинки не на свой диск, а на ImgBB (бесплатный ключ на
# api.imgbb.com, hotlink разрешён). Без ключа загрузка идёт в .data/uploads.
# IMGBB_API_KEY=
